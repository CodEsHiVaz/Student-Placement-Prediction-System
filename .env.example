# Copy this file to ".env" and fill in your own values.
# Do NOT commit the real .env file.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=False

# MySQL database connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=student_placement
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# Path to the trained ML model (relative to project root)
MODEL_PATH=ml/models/placement_model.pkl

# Dataset location (relative to project root).
DATASET_PATH=data/student_placement.csv

# Default admin account created by scripts/init_db.py.
# Change these before deploying anywhere.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
